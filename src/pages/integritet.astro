---
/** /integritet: the privacy policy, written in Markdown so it keeps its headings, lists and tables. */
import PageLayout from '~/layouts/PageLayout.astro';
import { Content, frontmatter } from '~/content/integritetspolicy.md';
---

<PageLayout title={frontmatter.title} description={frontmatter.description}>
  <div class="policy">
    <Content />
  </div>
</PageLayout>

<style>
  /* Markdown output has no classes of its own, so the policy's elements are styled here. */
  .policy > :global(* + *) {
    margin-top: 1rem;
  }
  .policy :global(h2) {
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-size: 1.625rem;
    line-height: 1.2;
    color: var(--color-ink);
  }
  .policy :global(h3) {
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--color-ink);
  }
  .policy :global(:is(h2, h3) + *) {
    margin-top: 0.75rem;
  }
  .policy :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .policy :global(li + li) {
    margin-top: 0.25rem;
  }
  .policy :global(strong) {
    color: var(--color-ink);
  }
  .policy :global(a) {
    color: var(--color-primary-dark);
    font-weight: 700;
  }
  .policy :global(code) {
    font-size: 0.875em;
    overflow-wrap: anywhere;
  }
  /* Wide tables scroll sideways inside the text column on phones instead of widening the page. */
  .policy :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .policy :global(th),
  .policy :global(td) {
    min-width: 9rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }
  .policy :global(th) {
    background: var(--color-cream-warm);
    color: var(--color-ink);
  }
  .policy :global(td:nth-child(3)) {
    min-width: 14rem;
  }
</style>
