---
import JsonLd from '~/components/seo/JsonLd.astro';
import EverydayValue from '~/components/sections/EverydayValue.astro';
import Hero from '~/components/sections/Hero.astro';
import HowItWorks from '~/components/sections/HowItWorks.astro';
import Pedagogue from '~/components/sections/Pedagogue.astro';
import Subscription from '~/components/sections/Subscription.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import { site } from '~/config/site';
import { copy } from '~/content/copy';
import BaseLayout from '~/layouts/BaseLayout.astro';

const siteUrl = Astro.site!.href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: site.name,
      url: siteUrl,
      logo: new URL('/favicon.svg', siteUrl).href,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: site.name,
      url: siteUrl,
      inLanguage: site.lang,
      publisher: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'Product',
      name: site.product,
      description: copy.seo.description,
      brand: { '@id': `${siteUrl}#organization` },
      offers: {
        '@type': 'Offer',
        url: siteUrl,
        price: copy.offer.price,
        priceCurrency: site.currency,
        // The service is not yet available; it is offered ahead of launch.
        availability: 'https://schema.org/PreOrder',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: copy.offer.price,
          priceCurrency: site.currency,
          referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'MON' },
        },
      },
    },
  ],
};
---

<BaseLayout>
  <JsonLd slot="head" data={structuredData} />
  <SiteHeader />
  <main id="main">
    <Hero />
    <HowItWorks />
    <EverydayValue />
    <Pedagogue />
    <Subscription />
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import { CTA_SECTION, isCtaId } from '~/config/site';
  import { trackExposure } from '~/lib/exposure';
  import { track, whenVisible } from '~/lib/tracking';

  whenVisible(() => {
    track('offer_view');
    const exposure = trackExposure();

    // Every buy click is kept as behaviour; reports count it once per session (brief B §7).
    document.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLElement>('[data-cta-id]');
      const ctaId = button?.dataset.ctaId;
      if (!isCtaId(ctaId)) return;
      track('purchase_click', { cta_id: ctaId, section_id: CTA_SECTION[ctaId], ...exposure.clickContext() });
    });
  });
</script>
