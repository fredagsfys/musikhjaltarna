---
import Button from '~/components/ui/Button.astro';
import Card from '~/components/ui/Card.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import { CTA_IDS, CTA_SECTION, ctaSlug, routes, site, type CtaId } from '~/config/site';
import { copy, priceLabel } from '~/content/copy';
import FlowLayout from '~/layouts/FlowLayout.astro';

/** `/kop` for direct visits, plus one path per buy button, e.g. `/kop/hero`. */
export function getStaticPaths() {
  return [
    { params: { cta: undefined }, props: { ctaId: null } },
    ...CTA_IDS.map((ctaId) => ({ params: { cta: ctaSlug(ctaId) }, props: { ctaId } })),
  ];
}

const { ctaId } = Astro.props as { ctaId: CtaId | null };
// Without history to go back to, return to the section of the button the visitor came from.
const backHref = ctaId ? `${routes.home}#${CTA_SECTION[ctaId]}` : routes.home;

const { purchase: content } = copy;
---

<!--
  Köpflöde steg 1: Bekräfta erbjudandet. Mätpunkt: köpintention, när besökaren går vidare.
  Inga personuppgifter här: namn och e-post lämnas bara i sista steget, med samtycke.
-->
<FlowLayout title="Köp prenumeration">
  <form
    id="lead-form"
    data-cta={ctaId}
    data-price={copy.offer.price}
    data-currency={site.currency}
    class="flex flex-col gap-[22px]"
    novalidate
  >
    <div id="kop_sammanfattning" class="flex flex-col gap-[22px]">
      <div class="flex flex-col items-center gap-2 text-center">
        <Eyebrow>{site.product}</Eyebrow>
        <h1 class="text-[clamp(1.875rem,4vw,2.375rem)] leading-[1.1] text-balance">{content.title}</h1>
        <p>{content.subtitle}</p>
      </div>

      <Card tone="bg" variant="price" class="px-[22px] py-4 text-center">
        <p class="font-display text-ink text-[2rem] leading-none">{priceLabel}</p>
      </Card>
    </div>

    <Button id="kop_skicka" type="submit">
      {content.submit}
    </Button>
    <Button id="kop_tillbaka" variant="link" arrow={false} href={backHref} class="self-center">
      {content.back}
    </Button>
  </form>
</FlowLayout>

<script>
  import { isCtaId, routes } from '~/config/site';
  import { loadCheckout, saveCheckout, type Checkout } from '~/lib/registration';
  import { track, whenVisible } from '~/lib/tracking';

  const form = document.querySelector<HTMLFormElement>('#lead-form')!;
  const ctaId = isCtaId(form.dataset.cta) ? form.dataset.cta : null;

  whenVisible(() => track('checkout_view', { cta_id: ctaId }));

  // Coming from the offer page, go back in history so the browser restores the scroll position.
  document.querySelector('#kop_tillbaka')!.addEventListener('click', (event) => {
    track('checkout_back', { cta_id: ctaId });
    const from = document.referrer ? new URL(document.referrer) : null;
    if (from?.origin === location.origin && from.pathname === routes.home && history.length > 1) {
      event.preventDefault();
      history.back();
    }
  });

  let leaving = false;
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    if (leaving) return;
    leaving = true;

    // Going back and on again continues the same visit, so it gives one purchase intent.
    const previous = loadCheckout();
    const checkout: Checkout = {
      id: previous?.id ?? crypto.randomUUID(),
      ctaId,
      intentTracked: previous?.intentTracked,
    };
    if (!checkout.intentTracked) {
      track('purchase_intent_submit', {
        event_id: `purchase_intent_submit:${checkout.id}`,
        registration_id: checkout.id,
        cta_id: ctaId,
        price: Number(form.dataset.price),
        currency: form.dataset.currency,
      });
      checkout.intentTracked = true;
    }
    saveCheckout(checkout);
    location.assign(routes.updates);
  });

  // Going back from step 2 restores this page as it was left; let the button work again.
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) leaving = false;
  });
</script>
