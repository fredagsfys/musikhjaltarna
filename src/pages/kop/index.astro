---
import Price from '~/components/ui/Price.astro';
import { routes } from '~/config/site';
import FlowLayout from '~/layouts/FlowLayout.astro';

const inputClass =
  'border-border bg-white focus:border-primary mt-1.5 block w-full rounded-xl border px-4 py-3 text-base outline-none';
---

<!-- Köpflöde steg 1: Fånga fördjupad köpavsikt. Mätpunkt: köpintention. -->
<FlowLayout title="Köp prenumeration">
  <h1 class="mt-6 text-2xl font-bold tracking-tight text-balance sm:text-3xl">Hjälpen mellan pianolektionerna</h1>
  <p class="text-text mt-2">Prenumeration på övningsverktyget i appen</p>
  <Price class="mt-4" />

  <form id="lead-form" class="mt-8 space-y-5 text-left" novalidate>
    <div>
      <label for="name" class="text-sm font-semibold">
        Namn
      </label>
      <input id="name" name="name" type="text" autocomplete="name" required class={inputClass} />
    </div>
    <div>
      <label for="email" class="text-sm font-semibold">
        E-post
      </label>
      <input id="email" name="email" type="email" inputmode="email" autocomplete="email" required class={inputClass} />
    </div>
    <button
      type="submit"
      class="bg-primary hover:bg-primary-dark min-h-12 w-full rounded-xl px-6 py-3 font-semibold text-white transition-colors disabled:opacity-60"
    >
      Gå vidare till betalning
    </button>
  </form>

  <a href={routes.home} class="text-text mt-6 inline-block text-sm underline underline-offset-4">
    Tillbaka till erbjudandet
  </a>
</FlowLayout>

<script>
  import { isCtaId, routes } from '~/config/site';
  import { track } from '~/lib/analytics';
  import { saveLead, submitLead, type Lead } from '~/lib/lead';

  const form = document.querySelector<HTMLFormElement>('#lead-form')!;
  const ctaParam = new URLSearchParams(location.search).get('cta');
  const ctaId = isCtaId(ctaParam) ? ctaParam : null;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const lead: Lead = {
      name: String(data.get('name')).trim(),
      email: String(data.get('email')).trim(),
      ctaId,
    };

    form.querySelector('button')!.disabled = true;
    saveLead(lead);
    track('purchase_intent', { cta_id: ctaId ?? undefined });
    try {
      await submitLead({ type: 'purchase_intent', lead });
    } catch (error) {
      // Don't block the visitor; the intent is still tracked as an event.
      console.error(error);
    }
    location.assign(routes.updates);
  });
</script>
