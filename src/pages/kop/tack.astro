---
import Button from '~/components/ui/Button.astro';
import IconBadge from '~/components/ui/IconBadge.astro';
import { routes } from '~/config/site';
import { copy } from '~/content/copy';

const { thanks: content } = copy;
import FlowLayout from '~/layouts/FlowLayout.astro';
---

<!-- Köpflöde steg 3: Gör fortsättningen tydlig. -->
<FlowLayout title={content.title}>
  <div class="flex flex-col items-center gap-[18px] text-center">
    <IconBadge icon="check" />
    <h1 class="text-[clamp(1.875rem,4vw,2.375rem)] leading-[1.1] text-balance">{content.title}</h1>
    <p class="text-pretty">{content.text}</p>
    <p class="flex flex-col gap-1">
      {content.sentTo}
      <strong id="lead-email" class="text-ink text-lg break-all">
        {content.emailFallback}
      </strong>
    </p>
    <Button variant="link" arrow={false} href={routes.home}>
      {content.back}
    </Button>
  </div>
</FlowLayout>

<script>
  import { takeConfirmation } from '~/lib/registration';
  import { track, whenVisible } from '~/lib/tracking';

  const confirmation = takeConfirmation();
  // Only after a stored "ja": a direct visit shows the generic text and sends nothing.
  if (confirmation) {
    document.querySelector('#lead-email')!.textContent = confirmation.email;
    whenVisible(() => track('updates_confirmation_view', { registration_id: confirmation.registrationId }));
  }
</script>
