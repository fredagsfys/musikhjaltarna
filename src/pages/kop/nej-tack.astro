---
import Button from '~/components/ui/Button.astro';
import IconBadge from '~/components/ui/IconBadge.astro';
import { routes, site } from '~/config/site';
import FlowLayout from '~/layouts/FlowLayout.astro';
---

<!-- Köpflöde steg 3, alternativ: besökaren tackade nej till uppdateringar. -->
<FlowLayout title="Tack för att du tittade förbi">
  <div class="flex flex-col items-center gap-[18px] text-center">
    <IconBadge icon="music" />
    <h1 class="text-[clamp(1.875rem,4vw,2.375rem)] leading-[1.1] text-balance">Tack för att du tittade förbi!</h1>
    <p class="text-pretty">Du får inga utskick från oss. Välkommen tillbaka när {site.product} lanseras.</p>
    <div class="flex flex-wrap items-center justify-center gap-x-6">
      <Button variant="link" arrow={false} href={routes.home}>
        Tillbaka till erbjudandet
      </Button>
      <Button variant="link" href={site.website}>
        Till Pianotopias webbplats
      </Button>
    </div>
  </div>
</FlowLayout>

<script>
  import { clearRegistration } from '~/lib/registration';

  // The flow is complete; a new visit starts a new registration.
  clearRegistration();
</script>
