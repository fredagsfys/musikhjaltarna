---
import Button from '~/components/ui/Button.astro';
import IconBadge from '~/components/ui/IconBadge.astro';
import { routes } from '~/config/site';
import { copy } from '~/content/copy';

const { declined: content } = copy;
import FlowLayout from '~/layouts/FlowLayout.astro';
---

<!-- Köpflöde steg 3, alternativ: besökaren tackade nej till uppdateringar. -->
<FlowLayout title={content.title}>
  <div class="flex flex-col items-center gap-[18px] text-center">
    <IconBadge icon="music" />
    <h1 class="text-[clamp(1.875rem,4vw,2.375rem)] leading-[1.1] text-balance">{content.title}</h1>
    <p class="text-pretty">{content.text}</p>
    <div class="flex flex-wrap items-center justify-center gap-x-6">
      <Button variant="link" arrow={false} href={routes.home}>
        {content.back}
      </Button>
      <Button variant="link" href={copy.links.website} data-link-id="pianotopia_website" data-link-placement="declined">
        {content.website}
      </Button>
    </div>
  </div>
</FlowLayout>
