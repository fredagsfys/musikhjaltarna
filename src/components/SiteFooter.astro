---
import { routes, site } from '~/config/site';

const links = [
  { href: routes.contact, label: 'Kontakt' },
  { href: routes.terms, label: 'Villkor' },
  { href: routes.privacy, label: 'Integritet' },
];
---

<footer class="gutter-x bg-white border-border border-t pt-8 pb-12">
  <div class="container-page text-text flex flex-wrap items-center justify-between gap-4 text-[0.9375rem]">
    <a href={routes.about} class="font-display text-ink hover:text-primary-dark text-xl no-underline">
      {site.name}
    </a>
    <nav aria-label="Sidfot">
      <ul class="flex flex-wrap gap-6">
        {links.map(({ href, label }) => (
          <li>
            <a href={href} class="text-text hover:text-ink">
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <p>
      © {new Date().getFullYear()} {site.legalName}
    </p>
  </div>
</footer>
