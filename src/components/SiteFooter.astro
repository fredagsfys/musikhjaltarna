---
import { routes, site } from '~/config/site';
import { copy } from '~/content/copy';

const links = [
  { href: routes.contact, label: copy.footer.contact },
  { href: routes.terms, label: copy.footer.terms },
  { href: routes.privacy, label: copy.footer.privacy },
];
---

<footer class="gutter-x bg-white border-border border-t pt-8 pb-12">
  <div class="container-page text-text flex flex-wrap items-center justify-between gap-4 text-[0.9375rem]">
    <a
      href={copy.links.website}
      data-link-id="pianotopia_website"
      data-link-placement="footer"
      class="font-display text-ink hover:text-primary-dark text-xl no-underline"
    >
      {site.name}
    </a>
    <nav aria-label="Sidfot">
      <ul class="flex flex-wrap gap-6">
        {links.map(({ href, label }) => (
          <li>
            <a href={href} class="text-text hover:text-ink">
              {label}
            </a>
          </li>
        ))}
        <li>
          <button type="button" data-consent-settings class="text-text hover:text-ink cursor-pointer underline">
            {copy.footer.consentSettings}
          </button>
        </li>
      </ul>
    </nav>
    <p>
      © {new Date().getFullYear()} {site.legalName}
    </p>
  </div>
</footer>
