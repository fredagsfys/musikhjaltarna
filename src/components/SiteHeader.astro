---
import Art from '~/components/ui/Art.astro';
import { routes, SECTION_IDS, site } from '~/config/site';
import { copy } from '~/content/copy';

export interface Props {
  /** Section navigation; off in the purchase flow. */
  nav?: boolean;
}

const { nav = true } = Astro.props;
// The section links show from tablets in portrait (768px) up; the link to the subscription always stays visible.
const navLink = 'text-ink rounded-pill hover:bg-white hover:text-ink inline-flex px-3.5 py-2.5 no-underline';
---

<header class="gutter-x border-border border-b py-[18px] short:py-2">
  <!-- The "Musikhjältarna" title banner. On phones, and again below 360px, it shrinks so the header stays on one row. -->
  <div class="container-page flex flex-wrap items-center justify-between gap-4 max-sm:gap-2">
    <a href={routes.home} class="flex min-w-0 items-center no-underline">
      <Art
        name="wordmark"
        alt={site.product}
        widths={[260, 520]}
        sizes="(min-width: 1024px) 260px, (min-width: 640px) 210px, 44vw"
        loading="eager"
        class="h-auto w-[260px] max-lg:w-[210px] max-sm:w-[min(44vw,180px)] max-[22.5rem]:w-[38vw]"
      />
    </a>
    {nav && (
      <nav aria-label="Huvudmeny">
        <ul class="flex flex-wrap gap-2 text-[1rem] font-bold">
          <li class="max-md:hidden">
            <a href={`/#${SECTION_IDS.hjalpen}`} class={navLink}>
              {copy.header.navHowItWorks}
            </a>
          </li>
          <li class="max-md:hidden">
            <a href={`/#${SECTION_IDS.pedagog}`} class={navLink}>
              {copy.header.navPedagogue}
            </a>
          </li>
          <li>
            <a
              href={`/#${SECTION_IDS.prenumeration}`}
              class:list={[navLink, 'max-sm:px-2.5 max-sm:text-[0.9375rem] max-[22.5rem]:px-2 max-[22.5rem]:text-sm']}
            >
              {copy.header.navSubscription}
            </a>
          </li>
        </ul>
      </nav>
    )}
  </div>
</header>
