---
import CharacterAvatar from '~/components/ui/CharacterAvatar.astro';
import { routes, SECTION_IDS, site } from '~/config/site';
import { copy, priceLabelShort } from '~/content/copy';

export interface Props {
  /** Section navigation; off in the purchase flow. */
  nav?: boolean;
}

const { nav = true } = Astro.props;
// The section links collapse on small screens; the price link always stays visible.
const navLink = 'text-ink rounded-pill hover:bg-white hover:text-ink inline-flex px-3.5 py-2.5 no-underline';
---

<header class="gutter-x border-border border-b py-[18px] short:py-2">
  <!-- Below 360px the gaps, name and price pill shrink so the header stays on one row. -->
  <div class="container-page flex flex-wrap items-center justify-between gap-4 max-[22.5rem]:gap-2">
    <a href={routes.home} class="text-ink hover:text-ink flex items-center gap-3 no-underline">
      <CharacterAvatar alt="" size={48} class="w-12 shrink-0" />
      <span class="flex flex-col leading-[1.1]">
        <span class="font-display text-[1.375rem] max-[22.5rem]:text-[1.25rem]">{site.name}</span>
        <span class="text-gold-brown text-[0.8125rem] font-bold tracking-[0.04em]">{site.product}</span>
      </span>
    </a>
    {nav && (
      <nav aria-label="Huvudmeny">
        <ul class="flex flex-wrap gap-2 text-[1rem] font-bold">
          <li class="max-sm:hidden">
            <a href={`/#${SECTION_IDS.hjalpen}`} class={navLink}>
              {copy.header.navHowItWorks}
            </a>
          </li>
          <li class="max-sm:hidden">
            <a href={`/#${SECTION_IDS.pedagog}`} class={navLink}>
              {copy.header.navPedagogue}
            </a>
          </li>
          <li>
            <a
              href={`/#${SECTION_IDS.prenumeration}`}
              class="text-primary-dark border-gold rounded-pill hover:bg-white inline-flex border-[1.5px] px-3.5 py-[9px] no-underline max-[22.5rem]:px-2.5"
            >
              {priceLabelShort}
            </a>
          </li>
        </ul>
      </nav>
    )}
  </div>
</header>
