---
/**
 * The choice about analytics (brief B §9; src/lib/consent.ts), in two layers:
 *
 * 1. A short question with "Godkänn alla" and "Hantera inställningar".
 * 2. Settings: what is measured, an opt-in checkbox that starts unticked, "Spara val" and "Godkänn alla".
 *    Saving without ticking the box declines.
 *
 * Declining is only on the second layer, by the client's choice; see docs/TRACKING.md#consent for the
 * regulatory risk. "Cookieinställningar" in the footer opens the settings layer. The page stays
 * usable while the banner is open.
 *
 * The first layer is a slim bar at the bottom of the screen. It never sits on a buy button: while it
 * would cover one, it slides down out of view and comes back when the button has passed. On the front
 * page that applies from arrival, so on screens too short for the hero and the bar together it appears
 * with the first scroll. On every other page it shows on load and steps aside only once the visitor
 * scrolls, so a visitor who goes straight to the purchase page is asked there.
 */
import { routes } from '~/config/site';
import { copy } from '~/content/copy';
import Button from './ui/Button.astro';

const content = copy.consent;
// Keeps words like "e-post" whole at line breaks.
const unbroken = (text: string) => text.replace(/(\p{L})-(\p{L})/gu, '$1‑$2');
const surface = 'container-page rounded-card border-border shadow-card pointer-events-auto border bg-white';
// The first layer: one row from tablets up, two short rows on phones.
const bar = `${surface} flex flex-col gap-2.5 p-3 sm:flex-row sm:items-center sm:gap-6 sm:py-3 sm:pr-3 sm:pl-5`;
const barButton = 'min-h-11! px-4! text-[0.9375rem]! sm:min-h-12! sm:px-6! sm:text-base!';
// The settings layer opens only when the visitor asks for it, so it keeps the roomier layout.
const card = `${surface} flex flex-col gap-4 p-4 sm:gap-5 sm:p-5 md:flex-row md:items-center md:gap-8 md:p-6`;
const actions = 'grid shrink-0 gap-2 sm:grid-cols-2 sm:gap-3 md:ml-auto';
const button = 'max-sm:min-h-12';
---

<div
  id="samtycke"
  role="dialog"
  aria-modal="false"
  aria-labelledby="samtycke-rubrik"
  hidden
  class="pointer-events-none fixed inset-x-0 bottom-0 z-40 px-3 pb-3 sm:px-6 sm:pb-4 md:px-8 transition-transform duration-300 ease-out data-tucked:translate-y-full motion-reduce:transition-none"
>
  <div data-layer="ask" class={bar}>
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 px-1 sm:px-0">
      <h2 id="samtycke-rubrik" class="font-display text-ink text-[1.0625rem] leading-tight sm:text-lg">
        {content.title}
      </h2>
      <a href={routes.privacy} class="text-primary-dark text-[0.9375rem] font-bold">
        {content.privacyLink}
      </a>
    </div>
    <div class="grid shrink-0 grid-cols-[auto_1fr] gap-2 sm:ml-auto sm:flex">
      <Button id="samtycke_godkann" type="button" class={barButton} arrow={false}>
        {content.acceptAll}
      </Button>
      <Button id="samtycke_hantera" type="button" class={barButton} variant="secondary">
        {content.manage}
      </Button>
    </div>
  </div>

  <div data-layer="settings" hidden class={card}>
    <div class="flex flex-col gap-3">
      <h2 id="samtycke-installningar-rubrik" tabindex="-1" class="font-display text-ink text-lg sm:text-xl">
        {content.settingsTitle}
      </h2>
      <label class="text-text flex items-start gap-3 text-[0.9375rem]">
        <input id="samtycke_matning" type="checkbox" class="accent-primary mt-1 size-5 shrink-0" />
        <span>
          <strong class="text-ink">{content.analyticsLabel}</strong>
          <span class="block">{unbroken(content.analyticsDescription)}</span>
        </span>
      </label>
      <a href={routes.privacy} class="text-primary-dark self-start text-[0.9375rem] font-bold">
        {content.privacyLink}
      </a>
    </div>
    <div class={actions}>
      <Button id="samtycke_spara" type="button" class={button} variant="secondary">
        {content.save}
      </Button>
      <Button id="samtycke_godkann_alla" type="button" class={button} arrow={false}>
        {content.acceptAll}
      </Button>
    </div>
  </div>
</div>

<script>
  import { routes } from '~/config/site';
  import { consent, setConsent, type ConsentChoice } from '~/lib/consent';

  const banner = document.querySelector<HTMLElement>('#samtycke')!;
  const ask = banner.querySelector<HTMLElement>('[data-layer="ask"]')!;
  const settings = banner.querySelector<HTMLElement>('[data-layer="settings"]')!;
  const analytics = banner.querySelector<HTMLInputElement>('#samtycke_matning')!;
  let returnFocus: HTMLElement | null = null;

  // Buy buttons on the landing page, the purchase page's button, and the last step's send button.
  const buyButtons = [...document.querySelectorAll<HTMLElement>('[data-cta-id], #kop_skicka, #uppdatering_ja')];

  /**
   * Whether the first layer, at its place on screen, would cover a buy button. Measured from where the
   * bar sits when shown, so the answer is the same while it is tucked away.
   */
  const wouldCover = () => {
    const bottom = innerHeight - parseFloat(getComputedStyle(banner).paddingBottom);
    const top = bottom - ask.offsetHeight;
    return buyButtons.some((button) => {
      const rect = button.getBoundingClientRect();
      return rect.height > 0 && rect.bottom > top && rect.top < bottom;
    });
  };

  // On pages other than the front page, the bar shows on load and steps aside only after a scroll.
  let mayTuck = location.pathname === routes.home;

  // Only the first layer steps aside. The settings are open because the visitor asked for them, and
  // the bar stays while it holds keyboard focus.
  const place = () => {
    const tuck = mayTuck && !banner.hidden && !ask.hidden && !banner.contains(document.activeElement) && wouldCover();
    banner.toggleAttribute('data-tucked', tuck);
  };

  let placing = false;
  const placeSoon = () => {
    if (placing || banner.hidden) return;
    placing = true;
    requestAnimationFrame(() => {
      placing = false;
      place();
    });
  };
  addEventListener(
    'scroll',
    () => {
      mayTuck = true;
      placeSoon();
    },
    { passive: true },
  );
  banner.addEventListener('focusin', place);
  banner.addEventListener('focusout', placeSoon);

  // While the banner is open, the page gets room at the bottom, so nothing stays hidden behind it.
  const reserveSpace = () => {
    document.body.style.paddingBottom = banner.hidden ? '' : `${banner.offsetHeight}px`;
  };
  // The page is watched too: buy buttons move when fonts and images load.
  const resized = new ResizeObserver(() => {
    reserveSpace();
    place();
  });
  resized.observe(banner);
  resized.observe(document.body);
  addEventListener('resize', placeSoon);

  function show(layer: 'ask' | 'settings') {
    ask.hidden = layer !== 'ask';
    settings.hidden = layer !== 'settings';
    banner.setAttribute('aria-labelledby', layer === 'ask' ? 'samtycke-rubrik' : 'samtycke-installningar-rubrik');
    // The box is ticked only when the visitor has already accepted; it never starts ticked otherwise.
    analytics.checked = consent() === 'granted';
    banner.hidden = false;
    reserveSpace();
    place();
  }

  function choose(choice: ConsentChoice) {
    setConsent(choice);
    banner.hidden = true;
    reserveSpace();
    returnFocus?.focus();
    returnFocus = null;
  }

  if (consent() === null) show('ask');
  banner.querySelector('#samtycke_godkann')!.addEventListener('click', () => choose('granted'));
  banner.querySelector('#samtycke_godkann_alla')!.addEventListener('click', () => choose('granted'));
  banner
    .querySelector('#samtycke_spara')!
    .addEventListener('click', () => choose(analytics.checked ? 'granted' : 'denied'));
  banner.querySelector('#samtycke_hantera')!.addEventListener('click', () => {
    show('settings');
    analytics.focus();
  });

  // "Cookieinställningar" in the footer opens the settings, to change or withdraw the choice.
  document.addEventListener('click', (event) => {
    const opener = (event.target as Element).closest<HTMLElement>('[data-consent-settings]');
    if (!opener) return;
    returnFocus = opener;
    show('settings');
    analytics.focus();
  });
</script>
