---
/**
 * The choice about analytics (brief B §9; src/lib/consent.ts), in two layers:
 *
 * 1. A short question with "Godkänn alla" and "Hantera inställningar".
 * 2. Settings: what is measured, an opt-in checkbox that starts unticked, "Spara val" and "Godkänn alla".
 *    Saving without ticking the box declines.
 *
 * Declining is only on the second layer, by the client's choice; see docs/TRACKING.md#consent for the
 * regulatory risk. "Integritetsinställningar" in the footer opens the settings layer. The page stays
 * usable while the banner is open.
 */
import { routes } from '~/config/site';
import { copy } from '~/content/copy';
import Button from './ui/Button.astro';

const content = copy.consent;
// Keeps words like "e-post" whole at line breaks.
const unbroken = (text: string) => text.replace(/(\p{L})-(\p{L})/gu, '$1‑$2');
const card =
  'container-page rounded-card border-border shadow-card pointer-events-auto flex flex-col gap-5 border bg-white p-5 md:flex-row md:items-center md:gap-8 md:p-6';
const actions = 'grid shrink-0 gap-3 sm:grid-cols-2 md:ml-auto';
---

<div
  id="samtycke"
  role="dialog"
  aria-modal="false"
  aria-labelledby="samtycke-rubrik"
  hidden
  class="gutter-x pointer-events-none fixed inset-x-0 bottom-0 z-40 pb-4"
>
  <div data-layer="ask" class={card}>
    <div class="flex flex-col gap-2">
      <h2 id="samtycke-rubrik" class="font-display text-ink text-xl">
        {content.title}
      </h2>
      <a href={routes.privacy} class="text-primary-dark self-start text-[0.9375rem] font-bold">
        {content.privacyLink}
      </a>
    </div>
    <div class={actions}>
      <Button id="samtycke_godkann" type="button" arrow={false}>
        {content.acceptAll}
      </Button>
      <Button id="samtycke_hantera" type="button" variant="secondary">
        {content.manage}
      </Button>
    </div>
  </div>

  <div data-layer="settings" hidden class={card}>
    <div class="flex flex-col gap-3">
      <h2 id="samtycke-installningar-rubrik" tabindex="-1" class="font-display text-ink text-xl">
        {content.settingsTitle}
      </h2>
      <label class="text-text flex items-start gap-3 text-[0.9375rem]">
        <input id="samtycke_matning" type="checkbox" class="accent-primary mt-1 size-5 shrink-0" />
        <span>
          <strong class="text-ink">{content.analyticsLabel}</strong>
          <span class="block">{unbroken(content.analyticsDescription)}</span>
        </span>
      </label>
      <a href={routes.privacy} class="text-primary-dark self-start text-[0.9375rem] font-bold">
        {content.privacyLink}
      </a>
    </div>
    <div class={actions}>
      <Button id="samtycke_spara" type="button" variant="secondary">
        {content.save}
      </Button>
      <Button id="samtycke_godkann_alla" type="button" arrow={false}>
        {content.acceptAll}
      </Button>
    </div>
  </div>
</div>

<script>
  import { consent, setConsent, type ConsentChoice } from '~/lib/consent';

  const banner = document.querySelector<HTMLElement>('#samtycke')!;
  const ask = banner.querySelector<HTMLElement>('[data-layer="ask"]')!;
  const settings = banner.querySelector<HTMLElement>('[data-layer="settings"]')!;
  const analytics = banner.querySelector<HTMLInputElement>('#samtycke_matning')!;
  let returnFocus: HTMLElement | null = null;

  // While the banner is open, the page gets room at the bottom, so nothing stays hidden behind it.
  const reserveSpace = () => {
    document.body.style.paddingBottom = banner.hidden ? '' : `${banner.offsetHeight}px`;
  };
  new ResizeObserver(reserveSpace).observe(banner);

  function show(layer: 'ask' | 'settings') {
    ask.hidden = layer !== 'ask';
    settings.hidden = layer !== 'settings';
    banner.setAttribute('aria-labelledby', layer === 'ask' ? 'samtycke-rubrik' : 'samtycke-installningar-rubrik');
    // The box is ticked only when the visitor has already accepted; it never starts ticked otherwise.
    analytics.checked = consent() === 'granted';
    banner.hidden = false;
    reserveSpace();
  }

  function choose(choice: ConsentChoice) {
    setConsent(choice);
    banner.hidden = true;
    reserveSpace();
    returnFocus?.focus();
    returnFocus = null;
  }

  if (consent() === null) show('ask');
  banner.querySelector('#samtycke_godkann')!.addEventListener('click', () => choose('granted'));
  banner.querySelector('#samtycke_godkann_alla')!.addEventListener('click', () => choose('granted'));
  banner
    .querySelector('#samtycke_spara')!
    .addEventListener('click', () => choose(analytics.checked ? 'granted' : 'denied'));
  banner.querySelector('#samtycke_hantera')!.addEventListener('click', () => {
    show('settings');
    analytics.focus();
  });

  // "Integritetsinställningar" in the footer opens the settings, to change or withdraw the choice.
  document.addEventListener('click', (event) => {
    const opener = (event.target as Element).closest<HTMLElement>('[data-consent-settings]');
    if (!opener) return;
    returnFocus = opener;
    show('settings');
    analytics.focus();
  });
</script>
