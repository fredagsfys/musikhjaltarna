---
/**
 * The choice about analytics (brief B §9; src/lib/consent.ts), in two layers:
 *
 * 1. A short question with "Godkänn alla" and "Hantera inställningar".
 * 2. Settings: what is measured, an opt-in checkbox that starts unticked, "Spara val" and "Godkänn alla".
 *    Saving without ticking the box declines.
 *
 * Declining is only on the second layer, by the client's choice; see docs/TRACKING.md#consent for the
 * regulatory risk. "Integritetsinställningar" in the footer opens the settings layer. The page stays
 * usable while the banner is open.
 *
 * The banner sits at the bottom of the screen, but never on top of a buy button: when it would cover
 * one, it moves to the top edge until the bottom is clear again.
 */
import { routes } from '~/config/site';
import { copy } from '~/content/copy';
import Button from './ui/Button.astro';

const content = copy.consent;
// Keeps words like "e-post" whole at line breaks.
const unbroken = (text: string) => text.replace(/(\p{L})-(\p{L})/gu, '$1‑$2');
const card =
  'container-page rounded-card border-border shadow-card pointer-events-auto flex flex-col gap-4 border bg-white p-4 sm:gap-5 sm:p-5 md:flex-row md:items-center md:gap-8 md:p-6';
const actions = 'grid shrink-0 gap-2 sm:grid-cols-2 sm:gap-3 md:ml-auto';
// Shorter buttons on phones, so the banner takes less of the screen.
const button = 'max-sm:min-h-12';
---

<div
  id="samtycke"
  role="dialog"
  aria-modal="false"
  aria-labelledby="samtycke-rubrik"
  hidden
  data-edge="bottom"
  class="gutter-x pointer-events-none fixed inset-x-0 z-40 data-[edge=bottom]:bottom-0 data-[edge=bottom]:pb-4 data-[edge=top]:top-0 data-[edge=top]:pt-4"
>
  <div data-layer="ask" class={card}>
    <div class="flex flex-col gap-2">
      <h2 id="samtycke-rubrik" class="font-display text-ink text-lg sm:text-xl">
        {content.title}
      </h2>
      <a href={routes.privacy} class="text-primary-dark self-start text-[0.9375rem] font-bold">
        {content.privacyLink}
      </a>
    </div>
    <div class={actions}>
      <Button id="samtycke_godkann" type="button" class={button} arrow={false}>
        {content.acceptAll}
      </Button>
      <Button id="samtycke_hantera" type="button" class={button} variant="secondary">
        {content.manage}
      </Button>
    </div>
  </div>

  <div data-layer="settings" hidden class={card}>
    <div class="flex flex-col gap-3">
      <h2 id="samtycke-installningar-rubrik" tabindex="-1" class="font-display text-ink text-lg sm:text-xl">
        {content.settingsTitle}
      </h2>
      <label class="text-text flex items-start gap-3 text-[0.9375rem]">
        <input id="samtycke_matning" type="checkbox" class="accent-primary mt-1 size-5 shrink-0" />
        <span>
          <strong class="text-ink">{content.analyticsLabel}</strong>
          <span class="block">{unbroken(content.analyticsDescription)}</span>
        </span>
      </label>
      <a href={routes.privacy} class="text-primary-dark self-start text-[0.9375rem] font-bold">
        {content.privacyLink}
      </a>
    </div>
    <div class={actions}>
      <Button id="samtycke_spara" type="button" class={button} variant="secondary">
        {content.save}
      </Button>
      <Button id="samtycke_godkann_alla" type="button" class={button} arrow={false}>
        {content.acceptAll}
      </Button>
    </div>
  </div>
</div>

<script>
  import { consent, setConsent, type ConsentChoice } from '~/lib/consent';

  const banner = document.querySelector<HTMLElement>('#samtycke')!;
  const ask = banner.querySelector<HTMLElement>('[data-layer="ask"]')!;
  const settings = banner.querySelector<HTMLElement>('[data-layer="settings"]')!;
  const analytics = banner.querySelector<HTMLInputElement>('#samtycke_matning')!;
  let returnFocus: HTMLElement | null = null;

  // Buy buttons on the landing page, and the submit button on the purchase page.
  const buyButtons = [...document.querySelectorAll<HTMLElement>('[data-cta-id], #kop_skicka')];

  /** How much of the visible buy buttons the banner covers at its current edge, in px². */
  const coveredArea = () => {
    const card = banner.querySelector<HTMLElement>('[data-layer]:not([hidden])')!.getBoundingClientRect();
    let area = 0;
    for (const button of buyButtons) {
      const rect = button.getBoundingClientRect();
      const width = Math.min(rect.right, card.right) - Math.max(rect.left, card.left);
      const height = Math.min(rect.bottom, card.bottom, innerHeight) - Math.max(rect.top, card.top, 0);
      if (width > 0 && height > 0) area += width * height;
    }
    return area;
  };

  // The bottom edge is preferred; the top edge is used while the bottom would cover a buy button. When
  // two buttons are on screen, one near each edge, the banner takes the edge that hides less of them,
  // usually one already scrolling off. The layout is read in the same frame as each move, so the
  // banner never shows in the wrong place.
  const place = () => {
    if (banner.hidden) return;
    banner.dataset.edge = 'bottom';
    const bottom = coveredArea();
    if (bottom === 0) return;
    banner.dataset.edge = 'top';
    if (coveredArea() >= bottom) banner.dataset.edge = 'bottom';
  };

  let placing = false;
  const placeSoon = () => {
    if (placing || banner.hidden) return;
    placing = true;
    requestAnimationFrame(() => {
      placing = false;
      place();
    });
  };
  addEventListener('scroll', placeSoon, { passive: true });

  // While the banner is open, the page gets room at the bottom, so nothing stays hidden behind it.
  const reserveSpace = () => {
    document.body.style.paddingBottom = banner.hidden ? '' : `${banner.offsetHeight}px`;
  };
  // The page is watched too: buy buttons move when fonts and images load.
  const resized = new ResizeObserver(() => {
    reserveSpace();
    place();
  });
  resized.observe(banner);
  resized.observe(document.body);
  addEventListener('resize', placeSoon);

  function show(layer: 'ask' | 'settings') {
    ask.hidden = layer !== 'ask';
    settings.hidden = layer !== 'settings';
    banner.setAttribute('aria-labelledby', layer === 'ask' ? 'samtycke-rubrik' : 'samtycke-installningar-rubrik');
    // The box is ticked only when the visitor has already accepted; it never starts ticked otherwise.
    analytics.checked = consent() === 'granted';
    banner.hidden = false;
    reserveSpace();
    place();
  }

  function choose(choice: ConsentChoice) {
    setConsent(choice);
    banner.hidden = true;
    reserveSpace();
    returnFocus?.focus();
    returnFocus = null;
  }

  if (consent() === null) show('ask');
  banner.querySelector('#samtycke_godkann')!.addEventListener('click', () => choose('granted'));
  banner.querySelector('#samtycke_godkann_alla')!.addEventListener('click', () => choose('granted'));
  banner
    .querySelector('#samtycke_spara')!
    .addEventListener('click', () => choose(analytics.checked ? 'granted' : 'denied'));
  banner.querySelector('#samtycke_hantera')!.addEventListener('click', () => {
    show('settings');
    analytics.focus();
  });

  // "Integritetsinställningar" in the footer opens the settings, to change or withdraw the choice.
  document.addEventListener('click', (event) => {
    const opener = (event.target as Element).closest<HTMLElement>('[data-consent-settings]');
    if (!opener) return;
    returnFocus = opener;
    show('settings');
    analytics.focus();
  });
</script>
