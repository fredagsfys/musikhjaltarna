---
/**
 * The choice about analytics (brief B §9; src/lib/consent.ts). Shown until the visitor decides, and
 * again from "Integritetsinställningar" in the footer. Accepting and declining are equally prominent,
 * and the page stays usable while it is open.
 */
import { routes } from '~/config/site';
import { copy } from '~/content/copy';
import Button from './ui/Button.astro';

const content = copy.consent;
---

<div
  id="samtycke"
  role="dialog"
  aria-modal="false"
  aria-labelledby="samtycke-rubrik"
  aria-describedby="samtycke-text"
  hidden
  class="gutter-x pointer-events-none fixed inset-x-0 bottom-0 z-40 pb-4"
>
  <div class="container-page rounded-card border-border shadow-card pointer-events-auto flex flex-col gap-5 border bg-white p-5 md:flex-row md:items-center md:gap-8 md:p-6">
    <div class="flex flex-col gap-2">
      <h2 id="samtycke-rubrik" class="font-display text-ink text-xl">
        {content.title}
      </h2>
      <p id="samtycke-text" class="text-text text-[0.9375rem]">
        {content.text}{' '}
        <a href={routes.privacy} class="text-primary-dark font-bold">
          {content.privacyLink}
        </a>
      </p>
    </div>
    <div class="grid shrink-0 grid-cols-2 gap-3">
      <Button id="samtycke_neka" type="button" variant="secondary" class="flex-1">
        {content.decline}
      </Button>
      <Button id="samtycke_godkann" type="button" variant="secondary" class="flex-1">
        {content.accept}
      </Button>
    </div>
  </div>
</div>

<script>
  import { consent, setConsent, type ConsentChoice } from '~/lib/consent';

  const banner = document.querySelector<HTMLElement>('#samtycke')!;
  let returnFocus: HTMLElement | null = null;

  // While the banner is open, the page gets room at the bottom, so nothing stays hidden behind it.
  const reserveSpace = () => {
    document.body.style.paddingBottom = banner.hidden ? '' : `${banner.offsetHeight}px`;
  };
  new ResizeObserver(reserveSpace).observe(banner);

  function show() {
    banner.hidden = false;
    reserveSpace();
  }

  function choose(choice: ConsentChoice) {
    setConsent(choice);
    banner.hidden = true;
    reserveSpace();
    returnFocus?.focus();
    returnFocus = null;
  }

  if (consent() === null) show();
  document.querySelector('#samtycke_godkann')!.addEventListener('click', () => choose('granted'));
  document.querySelector('#samtycke_neka')!.addEventListener('click', () => choose('denied'));

  // "Integritetsinställningar" in the footer opens the choice again, to change or withdraw it.
  document.addEventListener('click', (event) => {
    const opener = (event.target as Element).closest<HTMLElement>('[data-consent-settings]');
    if (!opener) return;
    returnFocus = opener;
    show();
    banner.querySelector<HTMLElement>(consent() === 'granted' ? '#samtycke_neka' : '#samtycke_godkann')!.focus();
  });
</script>
