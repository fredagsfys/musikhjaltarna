---
import { purchasePath, type CtaId } from '~/config/site';
import { copy, priceLabel } from '~/content/copy';
import Button from './Button.astro';

export interface Props {
  ctaId: CtaId;
  class?: string;
}

const { ctaId, class: className } = Astro.props;
---

<Button href={purchasePath(ctaId)} data-cta-id={ctaId} data-astro-prefetch class={className}>
  {copy.offer.buyButton} · {priceLabel}
</Button>
