---
import { purchasePath, type CtaId } from '~/config/site';
import { buyLabel } from '~/content/copy';
import Button from './Button.astro';

export interface Props {
  ctaId: CtaId;
  class?: string;
}

const { ctaId, class: className } = Astro.props;
---

<Button
  href={purchasePath(ctaId)}
  data-cta-id={ctaId}
  data-astro-prefetch
  class:list={[
    'max-sm:gap-2.5 max-sm:px-5 max-sm:text-[clamp(1rem,4.4vw,1.1875rem)] min-[22.5rem]:whitespace-nowrap',
    className,
  ]}
>
  {buyLabel}
</Button>
