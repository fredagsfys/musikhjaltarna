---
import { purchasePath, type CtaId } from '~/config/site';
import { buyLabel } from '~/content/copy';
import Button from './Button.astro';

export interface Props {
  ctaId: CtaId;
  class?: string;
}

const { ctaId, class: className } = Astro.props;
---

<Button
  href={purchasePath(ctaId)}
  data-cta-id={ctaId}
  data-astro-prefetch
  class:list={['max-sm:gap-3 max-sm:px-6', className]}
>
  {buyLabel}
</Button>
