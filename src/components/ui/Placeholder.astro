---
/** Wireframe stand-in for an illustration or screenshot that will be produced later. */
export interface Props {
  label: string;
  ratio?: string;
  class?: string;
}

const { label, ratio = '4 / 3', class: className } = Astro.props;
---

<div
  role="img"
  aria-label={`Platshållare: ${label}`}
  style={{ aspectRatio: ratio }}
  class:list={[
    'bg-cream-warm border-gold-light text-text rounded-card grid w-full place-items-center border-2 border-dashed p-4 text-center font-bold',
    className,
  ]}
>
  <span aria-hidden="true">{label}</span>
</div>
