---
import Art from './Art.astro';
import Icon from './Icon.astro';

/**
 * Drawn view of a practice in the app, from the client's mock-up: a hero asks the child to play
 * the notes as they light up, and the app answers "Rätt ton!". The notes light up one at a time, in a loop;
 * with reduced motion only E stays lit. It is an illustration, not a control: one image for screen readers,
 * and the "buttons" are plain shapes.
 */
export interface Props {
  speech: string;
  feedback: string;
  listen: string;
  play: string;
  alt: string;
  class?: string;
}

const { speech, feedback, listen, play, alt, class: className } = Astro.props;

// C4 to G4 on a treble staff: lines at y 40–100, 15 apart. C sits on a ledger line below the staff.
// The labels are large in viewBox units so they stay readable when the card is phone-sized.
const notes = [
  { name: 'C', y: 115 },
  { name: 'D', y: 107.5 },
  { name: 'E', y: 100, lit: true },
  { name: 'F', y: 92.5 },
  { name: 'G', y: 85 },
].map((note, i) => ({ ...note, x: 56 + i * 62 }));
const staffLines = [40, 55, 70, 85, 100];
const pill = 'rounded-pill inline-flex min-h-12 flex-1 items-center justify-center gap-2.5 px-5 font-extrabold';
---

<div
  role="img"
  aria-label={alt}
  class:list={['rounded-card border-border shadow-card w-full max-w-[460px] border bg-white p-5 sm:p-6', className]}
>
  <div aria-hidden="true" class="flex flex-col gap-5">
    <div class="flex items-center gap-4">
      <Art
        name="app-example-avatar"
        alt=""
        widths={[64, 128]}
        sizes="64px"
        class="rounded-tile size-16 shrink-0 object-cover"
      />
      <p class="border-border bg-bg rounded-tile text-ink border px-4 py-3 text-[0.9375rem] leading-snug font-bold">
        {speech}
      </p>
    </div>

    <div class="bg-bg border-gold-light rounded-tile flex flex-col items-center gap-2 border-2 px-3 pt-3 pb-4">
      <svg viewBox="0 0 360 152" class="text-ink w-full" fill="none">
        {staffLines.map((y) => (
          <line x1="16" x2="344" y1={y} y2={y} stroke="currentColor" stroke-width="1.6" />
        ))}
        {notes.map(({ name, x, y, lit }, i) => (
          <g class:list={['app-note', { 'is-lit': lit }]} style={`--i: ${i}`}>
            <circle cx={x} cy={y} r="17" class="app-note-halo fill-primary/20" />
            {name === 'C' && <line x1={x - 16} x2={x + 16} y1={y} y2={y} stroke="currentColor" stroke-width="1.6" />}
            <ellipse cx={x} cy={y} rx="9.5" ry="7" transform={`rotate(-20 ${x} ${y})`} fill="currentColor" />
            <line x1={x + 8.6} x2={x + 8.6} y1={y - 2} y2={y - 40} stroke-width="2.2" stroke="currentColor" />
            <text x={x} y="146" text-anchor="middle" class="app-note-label font-sans text-[19px] font-bold">
              {name}
            </text>
          </g>
        ))}
      </svg>
      <span class="rounded-pill bg-cream-warm text-primary-dark inline-flex items-center gap-2 px-4 py-1.5 text-[0.9375rem] font-bold">
        <Icon name="check" strokeWidth={2.6} class="size-4" />
        {feedback}
      </span>
    </div>

    <div class="flex gap-3">
      <span class:list={[pill, 'border-primary text-primary-dark border-2']}>
        <Icon name="speaker" class="size-5" />
        {listen}
      </span>
      <span class:list={[pill, 'bg-primary text-white']}>
        <Icon name="play" class="size-4" />
        {play}
      </span>
    </div>
  </div>
</div>

<style>
  .app-note {
    color: var(--color-ink);
  }
  .app-note-label {
    fill: var(--color-text);
  }
  .app-note-halo {
    opacity: 0;
  }
  .app-note.is-lit {
    color: var(--color-primary);
  }
  .is-lit .app-note-label {
    fill: var(--color-primary-dark);
  }
  .is-lit .app-note-halo {
    opacity: 1;
  }

  /* One note at a time, C to G, a second each. The negative delay starts every note mid-cycle, so C is lit at once. */
  @media (prefers-reduced-motion: no-preference) {
    .app-note,
    .app-note-label,
    .app-note-halo {
      animation: 5s ease-in-out calc(var(--i) * 1s - 5s) infinite;
    }
    .app-note {
      animation-name: app-note-color;
    }
    .app-note-label {
      animation-name: app-note-label;
    }
    .app-note-halo {
      animation-name: app-note-halo;
    }
  }

  @keyframes app-note-color {
    0%,
    18% {
      color: var(--color-primary);
    }
    22%,
    100% {
      color: var(--color-ink);
    }
  }
  @keyframes app-note-label {
    0%,
    18% {
      fill: var(--color-primary-dark);
    }
    22%,
    100% {
      fill: var(--color-text);
    }
  }
  @keyframes app-note-halo {
    0%,
    18% {
      opacity: 1;
    }
    22%,
    100% {
      opacity: 0;
    }
  }
</style>
