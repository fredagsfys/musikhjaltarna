---
import Art from './Art.astro';
import Icon from './Icon.astro';

/**
 * A playable practice from the app, after the client's mock-up. A hero asks the visitor to play the notes as they
 * light up: the lit note on the staff shows which key to press on the small keyboard below. Each right note earns a
 * star and plays its tone; after all five the hero celebrates. "Lyssna" plays the tune first. Until the visitor
 * starts, the notes light up one at a time in a loop (still, with only E lit, for reduced motion).
 */
export interface Props {
  speech: string;
  feedback: string;
  tryAgain: string;
  done: string;
  listen: string;
  play: string;
  playAgain: string;
  alt: string;
  class?: string;
}

const { speech, feedback, tryAgain, done, listen, play, playAgain, alt, class: className } = Astro.props;

// C4 to G4 on a treble staff: lines at y 40–100, 15 apart. C sits on a ledger line below the staff.
// The labels are large in viewBox units so they stay readable when the card is phone-sized.
const notes = [
  { name: 'C', y: 115, hz: 261.63 },
  { name: 'D', y: 107.5, hz: 293.66 },
  { name: 'E', y: 100, hz: 329.63 },
  { name: 'F', y: 92.5, hz: 349.23 },
  { name: 'G', y: 85, hz: 392.0 },
].map((note, i) => ({ ...note, x: 56 + i * 62 }));
const staffLines = [40, 55, 70, 85, 100];
// Black keys sit between C–D, D–E and F–G, as on a piano.
const blackAfter = new Set(['C', 'D', 'F']);
const pill =
  'rounded-pill inline-flex min-h-12 flex-1 cursor-pointer items-center justify-center gap-2.5 px-5 font-extrabold whitespace-nowrap max-sm:gap-2 max-sm:px-3 disabled:cursor-default disabled:opacity-60';
---

<div
  role="group"
  aria-label={alt}
  data-app-example
  data-messages={JSON.stringify({ speech, feedback, tryAgain, done, play, playAgain })}
  class:list={['rounded-card border-border shadow-card w-full max-w-[460px] border bg-white p-5 sm:p-6', className]}
>
  <div class="flex flex-col gap-5">
    <div class="flex items-center gap-4">
      <div data-hero class="app-hero shrink-0">
        <Art
          name="app-example-avatar"
          alt=""
          widths={[64, 128]}
          sizes="64px"
          class="rounded-tile size-16 object-cover max-[22.5rem]:size-12"
        />
      </div>
      <p
        data-speech
        class="border-border bg-bg rounded-tile text-ink flex-1 border px-4 py-3 text-[0.9375rem] leading-snug font-bold"
      >
        {speech}
      </p>
    </div>

    <div class="bg-bg border-gold-light rounded-tile relative flex flex-col items-center gap-2 border-2 px-3 pt-3 pb-4">
      <!-- Stars earned, one per right note. -->
      <ol class="flex gap-1.5" aria-hidden="true">
        {notes.map(() => (
          <li data-star class="app-star text-gold-light">
            <Icon name="star" class="size-5" />
          </li>
        ))}
      </ol>
      <svg viewBox="0 0 360 152" class="text-ink w-full" fill="none" aria-hidden="true">
        {staffLines.map((y) => (
          <line x1="16" x2="344" y1={y} y2={y} stroke="currentColor" stroke-width="1.6" />
        ))}
        {notes.map(({ name, x, y }, i) => (
          <g data-note={name} class:list={['app-note', { 'is-lit': name === 'E' }]} style={`--i: ${i}`}>
            <circle cx={x} cy={y} r="17" class="app-note-halo fill-primary/20" />
            {name === 'C' && <line x1={x - 16} x2={x + 16} y1={y} y2={y} stroke="currentColor" stroke-width="1.6" />}
            <ellipse cx={x} cy={y} rx="9.5" ry="7" transform={`rotate(-20 ${x} ${y})`} fill="currentColor" />
            <line x1={x + 8.6} x2={x + 8.6} y1={y - 2} y2={y - 40} stroke-width="2.2" stroke="currentColor" />
            <text x={x} y="146" text-anchor="middle" class="app-note-label font-sans text-[19px] font-bold">
              {name}
            </text>
          </g>
        ))}
      </svg>
      <span
        data-feedback
        aria-live="polite"
        class="rounded-pill bg-cream-warm text-primary-dark inline-flex min-h-8 items-center gap-2 px-4 py-1.5 text-[0.9375rem] font-bold"
      >
        <Icon name="check" strokeWidth={2.6} class="size-4" />
        <span data-feedback-text>{feedback}</span>
      </span>
      <!-- Confetti for the finished tune; decoration only. -->
      <div data-confetti class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true"></div>
    </div>

    <!-- The small keyboard: one key per note. Black keys are decoration. -->
    <div class="relative flex h-[clamp(5.5rem,22vw,7.5rem)] gap-1" data-keys>
      {notes.map(({ name, hz }) => (
        <button
          type="button"
          data-key={name}
          data-hz={hz}
          aria-label={name}
          class="app-key border-border text-text relative flex flex-1 cursor-pointer items-end justify-center rounded-b-[10px] border-2 bg-white pb-2 font-sans text-[0.9375rem] font-bold"
        >
          {name}
          {blackAfter.has(name) && (
            <span
              aria-hidden="true"
              class="bg-ink pointer-events-none absolute top-[-2px] -right-[calc(25%+2px)] z-10 h-[58%] w-1/2 rounded-b-md"
            />
          )}
        </button>
      ))}
    </div>

    <div class="flex flex-wrap gap-3">
      <button type="button" data-listen class:list={[pill, 'border-primary text-primary-dark border-2 bg-white']}>
        <Icon name="speaker" class="size-5" />
        {listen}
      </button>
      <button type="button" data-play class:list={[pill, 'bg-primary text-white']}>
        <Icon name="play" class="size-4" />
        <span data-play-label>{play}</span>
      </button>
    </div>
  </div>
</div>

<style>
  .app-note {
    color: var(--color-ink);
    transition: color 0.2s;
  }
  .app-note-label {
    fill: var(--color-text);
  }
  .app-note-halo {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 0.2s;
  }
  .app-note.is-lit {
    color: var(--color-primary);
  }
  .is-lit .app-note-label {
    fill: var(--color-primary-dark);
  }
  .is-lit .app-note-halo {
    opacity: 1;
  }
  .app-note.is-done {
    color: var(--color-gold-dark, #a8781c);
  }

  .app-star {
    transition:
      color 0.2s,
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .app-star.is-earned {
    color: var(--color-gold);
    transform: scale(1.2);
  }

  .app-key {
    transition:
      background-color 0.12s,
      transform 0.08s,
      border-color 0.12s;
  }
  .app-key:active,
  .app-key.is-down {
    transform: translateY(2px);
    background-color: var(--color-cream-warm);
  }
  .app-key.is-right {
    background-color: color-mix(in srgb, var(--color-primary) 22%, white);
    border-color: var(--color-primary);
  }
  .app-key.is-wrong {
    background-color: color-mix(in srgb, var(--color-gold) 25%, white);
    border-color: var(--color-gold);
  }

  .app-confetti {
    position: absolute;
    top: 40%;
    width: 8px;
    height: 12px;
    border-radius: 2px;
  }

  /* Before the visitor plays: one note at a time, C to G, a second each. The negative delay starts every note
     mid-cycle, so C is lit at once. */
  @media (prefers-reduced-motion: no-preference) {
    [data-app-example]:not(.is-playing) .app-note,
    [data-app-example]:not(.is-playing) .app-note-label,
    [data-app-example]:not(.is-playing) .app-note-halo {
      animation: 5s ease-in-out calc(var(--i) * 1s - 5s) infinite;
    }
    [data-app-example]:not(.is-playing) .app-note {
      animation-name: app-note-color;
    }
    [data-app-example]:not(.is-playing) .app-note-label {
      animation-name: app-note-label;
    }
    [data-app-example]:not(.is-playing) .app-note-halo {
      animation-name: app-note-halo;
    }
    .is-playing .is-lit .app-note-halo {
      animation: app-note-pulse 1.1s ease-in-out infinite;
    }
    .app-hero.is-cheering {
      animation: app-hero-cheer 0.6s ease-in-out 2;
    }
    .app-key.is-wrong {
      animation: app-key-shake 0.3s ease-in-out;
    }
    .app-confetti {
      animation: app-confetti 1.4s cubic-bezier(0.2, 0.7, 0.4, 1) forwards;
    }
  }

  @keyframes app-note-color {
    0%,
    18% {
      color: var(--color-primary);
    }
    22%,
    100% {
      color: var(--color-ink);
    }
  }
  @keyframes app-note-label {
    0%,
    18% {
      fill: var(--color-primary-dark);
    }
    22%,
    100% {
      fill: var(--color-text);
    }
  }
  @keyframes app-note-halo {
    0%,
    18% {
      opacity: 1;
    }
    22%,
    100% {
      opacity: 0;
    }
  }
  @keyframes app-note-pulse {
    50% {
      transform: scale(1.25);
    }
  }
  @keyframes app-hero-cheer {
    30% {
      transform: translateY(-8px) rotate(-6deg);
    }
    60% {
      transform: translateY(0) rotate(4deg);
    }
  }
  @keyframes app-key-shake {
    25% {
      translate: -3px 0;
    }
    75% {
      translate: 3px 0;
    }
  }
  @keyframes app-confetti {
    from {
      transform: translate(0, 0) rotate(0);
      opacity: 1;
    }
    to {
      transform: translate(var(--dx), var(--dy)) rotate(var(--r));
      opacity: 0;
    }
  }
</style>

<script>
  type Messages = Record<'speech' | 'feedback' | 'tryAgain' | 'done' | 'play' | 'playAgain', string>;

  const NOTE_ORDER = ['C', 'D', 'E', 'F', 'G'];
  const CONFETTI_COLOURS = ['var(--color-gold)', 'var(--color-primary)', 'var(--color-gold-light)', '#e2574c'];
  const reducedMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  let audio: AudioContext | undefined;
  /** A short, soft piano-like tone. Only starts after a tap or key press, as browsers require. */
  function tone(hz: number, at = 0) {
    audio ??= new AudioContext();
    if (audio.state === 'suspended') void audio.resume();
    const start = audio.currentTime + at;
    const gain = audio.createGain();
    gain.gain.setValueAtTime(0.0001, start);
    gain.gain.exponentialRampToValueAtTime(0.25, start + 0.015);
    gain.gain.exponentialRampToValueAtTime(0.0001, start + 1.1);
    gain.connect(audio.destination);
    for (const [type, multiple, level] of [
      ['triangle', 1, 1],
      ['sine', 2, 0.3],
    ] as const) {
      const osc = audio.createOscillator();
      const oscGain = audio.createGain();
      osc.type = type;
      osc.frequency.value = hz * multiple;
      oscGain.gain.value = level;
      osc.connect(oscGain).connect(gain);
      osc.start(start);
      osc.stop(start + 1.2);
    }
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-app-example]')) {
    const messages = JSON.parse(root.dataset.messages!) as Messages;
    const speech = root.querySelector<HTMLElement>('[data-speech]')!;
    const hero = root.querySelector<HTMLElement>('[data-hero]')!;
    const feedback = root.querySelector<HTMLElement>('[data-feedback]')!;
    const feedbackText = root.querySelector<HTMLElement>('[data-feedback-text]')!;
    const stars = [...root.querySelectorAll<HTMLElement>('[data-star]')];
    const confetti = root.querySelector<HTMLElement>('[data-confetti]')!;
    const playButton = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const playLabel = root.querySelector<HTMLElement>('[data-play-label]')!;
    const listenButton = root.querySelector<HTMLButtonElement>('[data-listen]')!;
    const noteEls = new Map(
      [...root.querySelectorAll<SVGGElement>('[data-note]')].map((el) => [el.dataset.note!, el] as const),
    );
    const keys = new Map(
      [...root.querySelectorAll<HTMLButtonElement>('[data-key]')].map((el) => [el.dataset.key!, el] as const),
    );
    const hzOf = (name: string) => Number(keys.get(name)!.dataset.hz);

    let step = -1; // -1 before the first play; 0–4 while playing; 5 when finished.
    let listening = false;

    function light(name: string | null) {
      for (const [note, el] of noteEls) el.classList.toggle('is-lit', note === name);
    }

    function say(text: string, ok: boolean | null) {
      feedbackText.textContent = text;
      // Keep the space, so the keyboard does not jump, but show no empty pill.
      feedback.style.visibility = text ? '' : 'hidden';
      feedback.querySelector('svg')!.style.display = ok ? '' : 'none';
    }

    function flash(key: HTMLButtonElement, className: string) {
      key.classList.remove('is-right', 'is-wrong');
      void key.offsetWidth; // Restart the animation on repeated presses.
      key.classList.add(className);
      setTimeout(() => key.classList.remove(className), 450);
    }

    function cheer() {
      hero.classList.remove('is-cheering');
      void hero.offsetWidth;
      hero.classList.add('is-cheering');
    }

    function burst() {
      if (reducedMotion()) return;
      for (let i = 0; i < 28; i++) {
        const piece = document.createElement('span');
        piece.className = 'app-confetti';
        piece.style.left = `${45 + Math.random() * 10}%`;
        piece.style.background = CONFETTI_COLOURS[i % CONFETTI_COLOURS.length]!;
        piece.style.setProperty('--dx', `${(Math.random() - 0.5) * 320}px`);
        piece.style.setProperty('--dy', `${-60 - Math.random() * 90}px`);
        piece.style.setProperty('--r', `${(Math.random() - 0.5) * 720}deg`);
        confetti.append(piece);
        setTimeout(() => piece.remove(), 1500);
      }
    }

    function start() {
      root.classList.add('is-playing');
      step = 0;
      stars.forEach((star) => star.classList.remove('is-earned'));
      noteEls.forEach((el) => el.classList.remove('is-done'));
      speech.textContent = messages.speech;
      say('', null);
      playLabel.textContent = messages.playAgain;
      light(NOTE_ORDER[0]!);
    }

    function press(name: string) {
      const key = keys.get(name)!;
      tone(hzOf(name));
      if (listening) return;
      if (step < 0 || step >= NOTE_ORDER.length) start();
      const target = NOTE_ORDER[step]!;
      if (name !== target) {
        flash(key, 'is-wrong');
        say(messages.tryAgain, false);
        return;
      }
      flash(key, 'is-right');
      noteEls.get(target)!.classList.add('is-done');
      stars[step]!.classList.add('is-earned');
      step++;
      if (step < NOTE_ORDER.length) {
        say(messages.feedback, true);
        light(NOTE_ORDER[step]!);
        return;
      }
      light(null);
      say(messages.feedback, true);
      speech.textContent = messages.done;
      cheer();
      burst();
      [0, 2, 4].forEach((i, n) => tone(hzOf(NOTE_ORDER[i]!), 0.35 + n * 0.12));
    }

    for (const [name, key] of keys) key.addEventListener('click', () => press(name));

    playButton.addEventListener('click', () => {
      start();
      keys.get('C')!.focus();
    });

    // Plays the tune once, lighting each note, then hands over to the visitor.
    listenButton.addEventListener('click', () => {
      if (listening) return;
      listening = true;
      root.classList.add('is-playing');
      listenButton.disabled = true;
      NOTE_ORDER.forEach((name, i) => {
        setTimeout(() => {
          light(name);
          tone(hzOf(name));
          keys.get(name)!.classList.add('is-down');
          setTimeout(() => keys.get(name)!.classList.remove('is-down'), 300);
        }, i * 550);
      });
      setTimeout(
        () => {
          listening = false;
          listenButton.disabled = false;
          start();
        },
        NOTE_ORDER.length * 550 + 300,
      );
    });
  }
</script>
