---
import MusicNotes from '~/components/doodles/MusicNotes.astro';
import Star from '~/components/doodles/Star.astro';
import BuyButton from '~/components/ui/BuyButton.astro';
import Card from '~/components/ui/Card.astro';
import CharacterAvatar from '~/components/ui/CharacterAvatar.astro';
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import TrustList from '~/components/ui/TrustList.astro';
import { site } from '~/config/site';

const placeholderItems = ['Lorem ipsum dolor sit amet', 'Consectetur adipiscing elit', 'Sed do eiusmod tempor'];
const details = ['Vad som ingår', 'Praktiska förutsättningar', 'Abonnemangsvillkor'];
---

<!-- Sektion 5: Samla erbjudandet. Bekräfta innehåll och pris, besvara kvarvarande frågor. -->
<Section id="pris">
  <MusicNotes slot="decor" class="text-gold absolute top-12 left-[6%] w-[60px] rotate-8 max-sm:hidden" />
  <Star slot="decor" class="text-gold absolute top-[60px] right-[7%] w-[30px] max-sm:hidden" />

  <div class="mx-auto flex max-w-[1100px] flex-col gap-8">
    <SectionHeading id="pris-title" eyebrow="Lorem ipsum" title="Din prenumeration" align="center" />

    <Card class="shadow-card flex flex-col gap-9 p-[clamp(1.75rem,4.5vw,3.5rem)]">
      <div class="flex flex-wrap items-center justify-between gap-6">
        <div class="flex items-center gap-[18px]">
          <CharacterAvatar alt="" size={72} class="w-[72px] shrink-0" />
          <div class="flex flex-col gap-0.5">
            <h3 class="text-h3">{site.product}</h3>
            <p>Övningsverktyg i appen för hjälp mellan pianolektionerna.</p>
          </div>
        </div>
        <div class="relative px-[26px] py-3.5">
          <svg
            viewBox="0 0 220 100"
            preserveAspectRatio="none"
            class="text-gold absolute inset-0 size-full"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M20 50C20 15 90 6 140 10C195 15 212 40 205 62C196 88 120 96 70 90C30 85 12 70 22 48C30 32 60 22 90 20"></path>
          </svg>
          <p class="font-display text-ink relative text-[clamp(3rem,5vw,4.25rem)] leading-none">
            <data value={site.offer.price}>{site.offer.price} kr</data>
            <span class="font-sans text-xl font-bold text-text">/månad</span>
          </p>
        </div>
      </div>

      <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
        {details.map((title) => (
          <Card tone="bg" variant="price" class="flex flex-col gap-4 p-6">
            <h4 class="text-h3">{title}</h4>
            <TrustList class="font-normal" items={placeholderItems} />
          </Card>
        ))}
      </div>

      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-4">
        <BuyButton ctaId="kop_avslut" />
        <TrustList items={['Ett komplement till barnets pianolärare']} />
      </div>
    </Card>
  </div>
</Section>
