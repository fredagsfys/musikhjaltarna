---
import MusicNotes from '~/components/doodles/MusicNotes.astro';
import Star from '~/components/doodles/Star.astro';
import Art from '~/components/ui/Art.astro';
import BuyButton from '~/components/ui/BuyButton.astro';
import Card from '~/components/ui/Card.astro';
import CharacterAvatar from '~/components/ui/CharacterAvatar.astro';
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import TrustList from '~/components/ui/TrustList.astro';
import { SECTION_IDS, site } from '~/config/site';
import { copy } from '~/content/copy';

const { subscription: content, offer } = copy;
// The title names the price, e.g. "För {pris} i månaden.", so it follows offer.price.
const title = content.title.replaceAll('{pris}', `${offer.price} kr`);
---

<!-- Sektion 5: Samla erbjudandet. Bekräfta innehåll och pris, besvara kvarvarande frågor. -->
<Section id={SECTION_IDS.prenumeration}>
  <MusicNotes slot="decor" class="text-gold absolute top-12 left-[6%] w-[60px] rotate-8 max-sm:hidden" />
  <Star slot="decor" class="text-gold absolute top-[60px] right-[7%] w-[30px] max-sm:hidden" />

  <div class="mx-auto flex max-w-[1100px] flex-col gap-8">
    <SectionHeading
      id={`${SECTION_IDS.prenumeration}-title`}
      eyebrow={content.eyebrow}
      title={title}
      align="center"
      class="max-w-[900px]!"
    />

    <Card class="shadow-card flex flex-col gap-9 p-[clamp(1.75rem,4.5vw,3.5rem)] max-sm:px-4">
      <div class="flex flex-wrap items-center justify-between gap-6">
        <div class="flex items-center gap-[18px]">
          <!-- The same logo and wordmark as in the header; the wordmark's alt text names the heading. -->
          <CharacterAvatar alt="" size={72} class="w-[72px] shrink-0 max-sm:w-14" />
          <h3>
            <Art
              name="wordmark"
              alt={site.product}
              widths={[260, 520]}
              sizes="(min-width: 640px) 260px, 50vw"
              class="h-auto w-[260px] max-sm:w-[min(50vw,220px)]"
            />
          </h3>
        </div>
        <div class="flex flex-col items-center gap-1.5">
          <div class="relative px-[26px] py-3.5">
            <svg
              viewBox="0 0 220 100"
              preserveAspectRatio="none"
              class="text-gold absolute inset-0 size-full"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M20 50C20 15 90 6 140 10C195 15 212 40 205 62C196 88 120 96 70 90C30 85 12 70 22 48C30 32 60 22 90 20"></path>
            </svg>
            <p class="font-display text-ink relative text-[clamp(3rem,5vw,4.25rem)] leading-none">
              <data value={offer.price}>{offer.price} kr</data>
              <span class="font-sans text-xl font-bold text-text">/{offer.period}</span>
            </p>
          </div>
          <p class="text-[0.9375rem]">{content.priceNote}</p>
        </div>
      </div>

      <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
        {content.boxes.map((box) => (
          <Card tone="bg" variant="price" class="flex flex-col gap-4 p-6">
            <h4 class="text-h3">{box.title}</h4>
            <TrustList class="font-normal" items={box.items} />
          </Card>
        ))}
      </div>

      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-4">
        <BuyButton ctaId="kop_avslut" />
        <TrustList items={[content.trust]} />
      </div>
    </Card>
  </div>
</Section>
