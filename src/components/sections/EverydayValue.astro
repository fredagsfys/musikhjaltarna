---
import MusicNote from '~/components/doodles/MusicNote.astro';
import Art from '~/components/ui/Art.astro';
import BuyButton from '~/components/ui/BuyButton.astro';
import Card from '~/components/ui/Card.astro';
import Icon, { type IconName } from '~/components/ui/Icon.astro';
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import { SECTION_IDS } from '~/config/site';
import { copy } from '~/content/copy';

const { everyday: content } = copy;
// The content file has exactly three benefits; each keeps its icon by position.
const icons: IconName[] = ['clock', 'star', 'home-heart'];
const benefits = content.benefits.map((benefit, i) => ({ ...benefit, icon: icons[i] }));
---

<!-- Sektion 3: Värdet i vardagen. Visa hur hjälpen passar ett fullt vardagsschema. -->
<Section id={SECTION_IDS.vardag}>
  <MusicNote slot="decor" class="text-gold absolute top-9 right-[5%] w-9 rotate-12 max-sm:hidden" />

  <div class="flex flex-wrap items-center gap-[clamp(2.5rem,5vw,4.5rem)]">
    <div class="flex min-w-0 flex-[1_1_340px] flex-col gap-5">
      <SectionHeading id={`${SECTION_IDS.vardag}-title`} eyebrow={content.eyebrow} title={content.title}>
        <p>{content.intro}</p>
      </SectionHeading>
      <!-- A child and Gilbert G-klav celebrating at home. Decoration: the text beside it says the same. -->
      <div class="border-border rounded-card shadow-card bg-cream-warm overflow-hidden border">
        <Art
          name="family-photo"
          alt=""
          widths={[480, 960]}
          sizes="(min-width: 1024px) 480px, 90vw"
          class="aspect-[1752/897] size-full object-cover"
        />
      </div>
      <BuyButton ctaId="kop_vardag" class="self-start" />
    </div>

    <ul class="flex min-w-0 flex-[1.3_1_460px] flex-col gap-4">
      {benefits.map(({ icon, title, text }) => (
        <Card as="li" class="flex items-start gap-5 p-6">
          <span class="bg-bg border-gold-light rounded-tile grid size-14 shrink-0 place-items-center border-2">
            <Icon name={icon} class="text-primary size-7" />
          </span>
          <div class="flex flex-col gap-1">
            <h3 class="text-h3">{title}</h3>
            <p>{text}</p>
          </div>
        </Card>
      ))}
    </ul>
  </div>
</Section>
