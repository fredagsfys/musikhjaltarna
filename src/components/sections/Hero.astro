---
import CurvedArrow from '~/components/doodles/CurvedArrow.astro';
import AccentHeading from '~/components/ui/AccentHeading.astro';
import BuyButton from '~/components/ui/BuyButton.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import Placeholder from '~/components/ui/Placeholder.astro';
import SpeechNote from '~/components/ui/SpeechNote.astro';
import TrustList from '~/components/ui/TrustList.astro';
import { SECTION_IDS } from '~/config/site';
import { copy } from '~/content/copy';

const { hero } = copy;
---

<!-- Sektion 1: Löftet och tjänsten. Barnets framsteg är huvudlöftet. -->
<section
  id={SECTION_IDS.hero}
  aria-labelledby={`${SECTION_IDS.hero}-title`}
  class="gutter-x overflow-x-clip pt-10 pb-16 sm:pt-14 lg:py-16 laptop:pt-8"
>
  <div class="container-page grid gap-16 lg:min-h-[min(85svh,56rem)] lg:grid-cols-[55fr_45fr] lg:items-center lg:gap-12 laptop:min-h-0 laptop:pt-6">
    <div class="@container min-w-0">
      <Eyebrow rule>{hero.eyebrow}</Eyebrow>
      <AccentHeading id={`${SECTION_IDS.hero}-title`} text={hero.title} accent={hero.titleAccent} class="mt-6 laptop:mt-4" />
      <p class="text-lead mt-8 lg:max-w-[34ch] laptop:mt-5 laptop:max-w-[46ch]">{hero.lead}</p>
      <BuyButton ctaId="kop_hero" class="mt-10 laptop:mt-7" />
      <TrustList class="mt-6 laptop:mt-4" items={[hero.trust]} />
    </div>

    <!--
      Geometry from the design file: a 500px stage, the arch inset 6% and 10% from the top, the note
      overhanging by 10%. From 640px the stage is 90% wide so the overhang stays inside the page gutter.
    -->
    <div class="relative mx-auto w-full max-w-[500px] min-w-0 px-[6%] pt-[10.2%] sm:w-[90%]">
      <Placeholder label={hero.imageLabel} ratio="1 / 1.043" shape="arch" />
      <div class="absolute top-0 right-0 flex rotate-5 flex-col items-end sm:-right-[10%]">
        <SpeechNote lines={hero.note} />
        <CurvedArrow class="text-gold mr-10 w-20" />
      </div>
    </div>
  </div>
</section>
