---
import AccentHeading from '~/components/ui/AccentHeading.astro';
import BuyButton from '~/components/ui/BuyButton.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import Art from '~/components/ui/Art.astro';
import CurvedArrow from '~/components/doodles/CurvedArrow.astro';
import TrustList from '~/components/ui/TrustList.astro';
import { SECTION_IDS } from '~/config/site';
import { copy } from '~/content/copy';

const { hero } = copy;
---

<!-- Sektion 1: Löftet och tjänsten. Barnets framsteg är huvudlöftet. -->
<section
  id={SECTION_IDS.hero}
  aria-labelledby={`${SECTION_IDS.hero}-title`}
  class="gutter-x overflow-x-clip pt-10 pb-16 sm:pt-14 lg:py-16 laptop:pt-4 phone:pt-3 short:pt-3"
>
  <div class="container-page grid gap-16 lg:min-h-[min(85svh,56rem)] lg:grid-cols-[55fr_45fr] lg:items-center lg:gap-12 laptop:min-h-0 laptop:pt-2">
    <div class="@container min-w-0">
      <!-- On phones the eyebrow drops its rule and tightens so it fits on one line, and the hero gets clearer gaps. -->
      <Eyebrow rule class="max-sm:text-[0.75rem] max-sm:tracking-[0.06em] max-sm:[&>span]:hidden">
        {hero.eyebrow}
      </Eyebrow>
      <AccentHeading
        id={`${SECTION_IDS.hero}-title`}
        text={hero.title}
        accent={hero.titleAccent}
        class="laptop:[@media(height<=45rem)]:text-[length:min(clamp(2.75rem,1.8rem_+_4.2vw,4.75rem),15cqi,7svh)]! mt-6 laptop:mt-3 phone:mt-3 phone:text-[2.25rem]! short:mt-2 short:text-[1.75rem]!"
      />
      <p class="text-lead mt-8 lg:max-w-[34ch] laptop:mt-4 laptop:max-w-[46ch] phone:mt-5 phone:text-base! phone:leading-[1.5]! short:mt-2 short:text-base! short:leading-snug!">
        {hero.lead}
      </p>
      <BuyButton ctaId="kop_hero" class="mt-10 laptop:mt-5 phone:mt-5 short:mt-3" />
      <TrustList
        class="mt-6 laptop:mt-4 phone:mt-3.5 short:mt-2 max-sm:gap-2.5 max-sm:text-[0.9375rem] max-sm:font-semibold max-sm:[&_li]:gap-2.5"
        items={[hero.trust]}
      />
    </div>

    <!-- The photo in the arch from the design file: domed top, straight sides, softly rounded bottom. -->
    <div class="relative mx-auto w-full max-w-[500px] min-w-0 px-[6%] pt-[6%] sm:w-[90%]">
      <div class="border-gold-light bg-cream-warm aspect-[1/1.043] overflow-hidden rounded-[48%_48%_40px_40px] border-2">
        <Art
          name="hero-photo"
          alt={hero.imageAlt}
          widths={[460, 700, 920]}
          sizes="(min-width: 1024px) 460px, (min-width: 640px) 450px, 88vw"
          loading="eager"
          fetchpriority="high"
          class="size-full object-cover object-[62%_center]"
        />
      </div>
      <!-- Handwritten "På svenska" in the empty corner above the arch, with an arrow down to the photo. -->
      <div class="absolute top-0 right-0 flex rotate-5 flex-col items-end sm:-right-[6%]">
        <p class="font-hand text-gold-brown text-[1.75rem] leading-none font-bold sm:text-[2rem]">{hero.note}</p>
        <CurvedArrow class="text-gold mr-8 w-16 sm:w-20" />
      </div>
    </div>
  </div>
</section>
