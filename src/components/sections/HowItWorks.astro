---
import PianoKeys from '~/components/doodles/PianoKeys.astro';
import AppExample from '~/components/ui/AppExample.astro';
import Art from '~/components/ui/Art.astro';
import BuyButton from '~/components/ui/BuyButton.astro';
import Card from '~/components/ui/Card.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import Lines from '~/components/ui/Lines.astro';
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import { SECTION_IDS } from '~/config/site';
import { copy } from '~/content/copy';

const { howItWorks: content } = copy;
// One picture per step: a child with the app (start), the app screen (practise), the reward. Photos fill the frame;
// app art and stickers are shown whole.
const stepImages = [
  { name: 'step-start', fit: 'object-cover object-[center_30%]' },
  { name: 'step-practise', fit: 'object-contain p-3' },
  { name: 'step-reward', fit: 'object-contain p-10' },
] as const;
---

<!-- Sektion 2: Konkretisera hjälpen. Visa hur barnet använder verktyget hemma. -->
<Section id={SECTION_IDS.hjalpen} tone="white">
  <div class="flex flex-col gap-12">
    <SectionHeading id={`${SECTION_IDS.hjalpen}-title`} eyebrow={content.eyebrow} title={content.title} align="center">
      <p>{content.intro}</p>
    </SectionHeading>

    <ol class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-5">
      {content.steps.map((step, i) => (
        <Card as="li" tone="bg" class="flex flex-col overflow-hidden">
          <div class="border-border aspect-[4/3] overflow-hidden border-b bg-white">
            <Art
              name={stepImages[i]!.name}
              alt=""
              widths={[360, 720]}
              sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
              class:list={['size-full', stepImages[i]!.fit]}
            />
          </div>
          <div class="flex flex-col gap-4 px-7 pb-8">
            <!-- The step number sits on the picture's lower edge. -->
            <span
              aria-hidden="true"
              class="border-gold text-primary-dark font-display relative -mt-[26px] grid size-13 place-items-center rounded-full border-2 bg-white text-2xl"
            >
              {i + 1}
            </span>
            <h3 class="text-h3">{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </Card>
      ))}
    </ol>

    <Card
      tone="bg"
      class="relative flex flex-wrap items-center gap-[clamp(2rem,5vw,4rem)] p-[clamp(1.75rem,4vw,3.5rem)]"
    >
      <PianoKeys class="text-gold absolute -top-[42px] right-7 w-[150px] rotate-4 max-sm:hidden" />
      <div class="flex min-w-0 flex-[1_1_360px] flex-col gap-4">
        <Eyebrow>{content.example.eyebrow}</Eyebrow>
        <h3 class="text-h2 text-balance">
          <Lines text={content.example.title} />
        </h3>
        <p>{content.example.text}</p>
        <BuyButton ctaId="kop_hjalpen" class="mt-2 self-start" />
      </div>
      <div class="relative flex min-w-0 flex-[1_1_400px] justify-center">
        <AppExample {...content.example.app} />
        <span
          aria-hidden="true"
          class="font-hand text-hand text-gold-brown absolute -bottom-11 left-6 -rotate-4 max-sm:hidden"
        >
          {content.example.note}
        </span>
      </div>
    </Card>
  </div>
</Section>
