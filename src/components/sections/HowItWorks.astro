---
import BuyButton from '~/components/ui/BuyButton.astro';
import Placeholder from '~/components/ui/Placeholder.astro';
import Section from '~/components/ui/Section.astro';

const steps = ['Kom igång', 'Öva självständigt', 'Kom vidare'];
---

<!-- Sektion 2: Konkretisera hjälpen. Visa hur barnet använder verktyget hemma. -->
<Section id="sa-fungerar-det" tone="muted">
  <div class="grid gap-10 md:grid-cols-[3fr_2fr] md:items-center md:gap-14">
    <div>
      <h2 id="sa-fungerar-det-title" class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        Så fungerar övningen
      </h2>

      <ol class="mt-8 grid grid-cols-3 gap-6 sm:gap-10">
        {steps.map((step) => (
          <li class="not-last:after:text-text relative text-center not-last:after:absolute not-last:after:top-[calc(50%-1.5rem)] not-last:after:-right-5 not-last:after:text-xl not-last:after:content-['→'] sm:not-last:after:-right-7">
            <Placeholder label="Bild" ratio="1 / 1" />
            <span class="mt-3 block text-sm font-semibold sm:text-base">{step}</span>
          </li>
        ))}
      </ol>

      <p class="text-text mt-8 max-w-prose text-pretty">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore
        magna aliqua.
      </p>
      <BuyButton ctaId="kop_hjalpen" class="mt-8" />
    </div>

    <Placeholder label="Exempel på övning i appen" ratio="1 / 1" />
  </div>
</Section>
