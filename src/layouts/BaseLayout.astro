---
import '~/styles/global.css';
import dmSerifUrl from '@fontsource/dm-serif-display/files/dm-serif-display-latin-400-normal.woff2?url';
import nunitoSansUrl from '@fontsource-variable/nunito-sans/files/nunito-sans-latin-wght-normal.woff2?url';
import ConsentBanner from '~/components/ConsentBanner.astro';
import SEO, { type Props as SEOProps } from '~/components/seo/SEO.astro';
import { pageVersion } from '~/config/build';
import { site } from '~/config/site';

export type Props = SEOProps;
---

<!doctype html>
<html lang={site.lang} data-page-version={pageVersion}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="generator" content={Astro.generator} />
    <meta name="facebook-domain-verification" content={site.facebookDomainVerification} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Only the headline and body fonts are preloaded; the handwriting font is not on the LCP path. -->
    <link rel="preload" href={dmSerifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={nunitoSansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {...Astro.props} />
    <slot name="head" />
    <script is:inline>
      // Internal tests: opening any page with ?test flags this session's registrations (see lib/registration.ts).
      try {
        if (new URLSearchParams(location.search).has('test')) sessionStorage.setItem('musikhjaltarna:test', '1');
      } catch {}
    </script>
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:shadow"
    >
      Hoppa till innehållet
    </a>
    <!-- First in the page, so keyboard and screen reader users reach the choice first; shown at the bottom. -->
    <ConsentBanner />
    <slot />

    <script>
      import { initTracking, track } from '~/lib/tracking';

      initTracking();
      // Links to Pianotopia's website carry data-link-id and data-link-placement (brief B §4).
      document.addEventListener('click', (event) => {
        const link = (event.target as Element).closest<HTMLElement>('[data-link-id]');
        if (!link) return;
        track('external_link_click', { link_id: link.dataset.linkId, placement: link.dataset.linkPlacement });
      });
    </script>
  </body>
</html>
