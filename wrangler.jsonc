// Cloudflare Workers: static assets for the site, plus a small API in worker/index.ts that stores leads.
// https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "musikhjaltarna",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serves `kop.html` at `/kop`, matching the canonical URLs and the sitemap.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get `dist/404.html` with a 404 status.
    "not_found_handling": "404-page",
    // Only the API runs the Worker; every other request is served straight from the assets.
    "run_worker_first": ["/api/*"],
  },
  // Stores leads from the purchase flow (worker/index.ts creates the table).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "musikhjaltarna",
      "database_id": "e819cc7d-ff63-4b51-a9ca-ccf4f3aff25e",
    },
  ],
  // Branch previews (`npx wrangler preview`) don't inherit bindings. They get their own database,
  // so test submissions in a preview never reach real registrations.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "musikhjaltarna-preview",
        "database_id": "7dc608b6-c7af-44e3-836a-b9910f4ebc79",
      },
    ],
  },
}
