// Cloudflare Workers static assets: serves the Astro build output, no Worker script needed.
// https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "musikhjaltarna",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    // Serves `kop.html` at `/kop`, matching the canonical URLs and the sitemap.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get `dist/404.html` with a 404 status.
    "not_found_handling": "404-page",
  },
}
